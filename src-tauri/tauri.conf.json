{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Groovium",
  "version": "1.0.3",
  "identifier": "com.groovium.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Groovium",
        "width": 340,
        "height": 480,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "visible": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://sdk.scdn.co",
        "img-src": "'self' asset: http://asset.localhost https://i.scdn.co",
        "media-src": "'self' asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.spotify.com https://*.spotify.com wss://*.spotify.com https://*.scdn.co",
        "frame-src": "'self' https://sdk.scdn.co",
        "object-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A desktop music player widget.",
    "longDescription": "A lightweight, modern desktop music player widget with a vintage disk player aesthetic.",
    "publisher": "Murat Emre Bicici",
    "copyright": "Copyright © Murat Emre Bicici. MIT licensed.",
    "category": "Music",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MuratBicici/Groovium/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2MTczQjczMTE0Qjg1NjQKUldSa2hVc1JjenNYTm5WM3Jma3VQS2RyWlQrYjlGZU5oT1JuN2E0dGRBYU9zaHJacGd0cFFPY0MK"
    }
  }
}
